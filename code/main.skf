// ============================================
//   skf-datetime — расширенная работа с датами
//   от SkyMonder
// ============================================


// --------------------------------------------
//   СОЗДАНИЕ ДАТ
// --------------------------------------------

функция создать(год, месяц, день) {
    // Создаёт объект даты (без времени)
    подключить_питон("datetime")
    попробовать {
        вернуть datetime.date(год, месяц, день)
    } поймать (ошибка) {
        бросить "Не удалось создать дату: " + ошибка
    }
}

функция создать_время(час, минута, секунда) {
    // Создаёт объект времени (без даты)
    подключить_питон("datetime")
    
    если (секунда == ничего) {
        секунда = 0
    }
    
    попробовать {
        вернуть datetime.time(час, минута, секунда)
    } поймать (ошибка) {
        бросить "Не удалось создать время: " + ошибка
    }
}

функция создать_datetime(год, месяц, день, час, минута, секунда) {
    // Создаёт объект даты и времени
    подключить_питон("datetime")
    
    если (час == ничего) { час = 0 }
    если (минута == ничего) { минута = 0 }
    если (секунда == ничего) { секунда = 0 }
    
    попробовать {
        вернуть datetime.datetime(год, месяц, день, час, минута, секунда)
    } поймать (ошибка) {
        бросить "Не удалось создать datetime: " + ошибка
    }
}

функция сейчас() {
    // Текущая дата и время (локальные)
    подключить_питон("datetime")
    вернуть datetime.datetime.now()
}

функция сегодня() {
    // Сегодняшняя дата
    подключить_питон("datetime")
    вернуть datetime.date.today()
}

функция utc_сейчас() {
    // Текущее время в UTC
    подключить_питон("datetime")
    вернуть datetime.datetime.utcnow()
}


// --------------------------------------------
//   ПАРСИНГ (СТРОКА → ДАТА)
// --------------------------------------------

функция разобрать(строка, формат) {
    // Парсит строку в дату по указанному формату.
    // Пример: разобрать("25.12.2025", "%d.%m.%Y")
    подключить_питон("datetime")
    
    если (формат == ничего) {
        формат = "%Y-%m-%d"
    }
    
    попробовать {
        вернуть datetime.datetime.strptime(строка, формат).date()
    } поймать (ошибка) {
        бросить "Не удалось разобрать дату: " + ошибка
    }
}

функция разобрать_datetime(строка, формат) {
    // Парсит строку в datetime
    подключить_питон("datetime")
    
    если (формат == ничего) {
        формат = "%Y-%m-%d %H:%M:%S"
    }
    
    попробовать {
        вернуть datetime.datetime.strptime(строка, формат)
    } поймать (ошибка) {
        бросить "Не удалось разобрать datetime: " + ошибка
    }
}

функция разобрать_iso(строка) {
    // Парсит ISO-строку (2025-12-25T14:30:00)
    подключить_питон("datetime")
    попробовать {
        вернуть datetime.datetime.fromisoformat(строка)
    } поймать (ошибка) {
        бросить "Не удалось разобрать ISO: " + ошибка
    }
}

функция из_timestamp(секунды) {
    // Создаёт datetime из Unix timestamp
    подключить_питон("datetime")
    вернуть datetime.datetime.fromtimestamp(секунды)
}

функция в_timestamp(объект_datetime) {
    // Преобразует datetime в Unix timestamp
    подключить_питон("datetime")
    вернуть объект_datetime.timestamp()
}


// --------------------------------------------
//   ФОРМАТИРОВАНИЕ (ДАТА → СТРОКА)
// --------------------------------------------

функция форматировать(объект, формат) {
    // Форматирует дату/время в строку.
    // Пример: форматировать(сегодня(), "%d.%m.%Y")
    если (формат == ничего) {
        формат = "%d.%m.%Y"
    }
    вернуть объект.strftime(формат)
}

функция в_iso(объект) {
    // Преобразует в ISO-строку (2025-12-25T14:30:00)
    вернуть объект.isoformat()
}

функция по_русски(объект) {
    // Красивая русская дата: "25 декабря 2025"
    подключить_питон("datetime")
    пусть месяцы = [
        "января", "февраля", "марта", "апреля", "мая", "июня",
        "июля", "августа", "сентября", "октября", "ноября", "декабря"
    ]
    вернуть строка(объект.day) + " " + месяцы[объект.month - 1] + " " + строка(объект.year)
}

функция день_недели(объект) {
    // Название дня недели на русском
    пусть дни = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    вернуть дни[объект.weekday()]
}

функция день_недели_коротко(объект) {
    // Короткое название дня недели: "Пн", "Вт" и т.д.
    пусть дни = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
    вернуть дни[объект.weekday()]
}

функция название_месяца(объект) {
    // Название месяца на русском
    пусть месяцы = [
        "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
        "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"
    ]
    вернуть месяцы[объект.month - 1]
}

функция номер_недели(объект) {
    // Номер недели в году (1-53)
    подключить_питон("datetime")
    вернуть объект.isocalendar()[1]
}

функция квартал(объект) {
    // Номер квартала (1-4)
    вернуть (объект.month - 1) // 3 + 1
}


// --------------------------------------------
//   КОМПОНЕНТЫ ДАТЫ
// --------------------------------------------

функция год(объект) {
    вернуть объект.year
}

функция месяц(объект) {
    вернуть объект.month
}

функция день(объект) {
    вернуть объект.day
}

функция час(объект) {
    вернуть объект.hour
}

функция минута(объект) {
    вернуть объект.minute
}

функция секунда(объект) {
    вернуть объект.second
}

функция день_года(объект) {
    // Номер дня в году (1-366)
    вернуть объект.timetuple().tm_yday
}


// --------------------------------------------
//   АРИФМЕТИКА ДАТ
// --------------------------------------------

функция добавить_дней(объект, количество) {
    // Добавляет указанное число дней к дате
    подключить_питон("datetime")
    вернуть объект + datetime.timedelta(days=количество)
}

функция добавить_часов(объект, количество) {
    // Добавляет часы к datetime
    подключить_питон("datetime")
    вернуть объект + datetime.timedelta(hours=количество)
}

функция добавить_минут(объект, количество) {
    // Добавляет минуты к datetime
    подключить_питон("datetime")
    вернуть объект + datetime.timedelta(minutes=количество)
}

функция добавить_секунд(объект, количество) {
    // Добавляет секунды к datetime
    подключить_питон("datetime")
    вернуть объект + datetime.timedelta(seconds=количество)
}

функция добавить_недель(объект, количество) {
    // Добавляет недели к дате
    вернуть добавить_дней(объект, количество * 7)
}

функция добавить_месяцев(объект, количество) {
    // Добавляет месяцы к дате (с переносом через год)
    подключить_питон("datetime")
    пусть новый_месяц = объект.month + количество
    пусть новый_год = объект.year
    
    пока (новый_месяц > 12) {
        новый_месяц = новый_месяц - 12
        новый_год = новый_год + 1
    }
    пока (новый_месяц < 1) {
        новый_месяц = новый_месяц + 12
        новый_год = новый_год - 1
    }
    
    попробовать {
        вернуть объект.replace(year=новый_год, month=новый_месяц)
    } поймать (ошибка) {
        // Если день не существует в новом месяце (например, 31 февраля)
        вернуть объект.replace(year=новый_год, month=новый_месяц, day=1)
    }
}

функция добавить_лет(объект, количество) {
    // Добавляет годы к дате
    подключить_питон("datetime")
    попробовать {
        вернуть объект.replace(year=объект.year + количество)
    } поймать (ошибка) {
        // 29 февраля в невисокосный год
        вернуть объект.replace(year=объект.year + количество, day=28)
    }
}


// --------------------------------------------
//   РАЗНИЦА МЕЖДУ ДАТАМИ
// --------------------------------------------

функция разница(дата1, дата2) {
    // Возвращает разницу в виде timedelta (дата1 - дата2)
    вернуть дата1 - дата2
}

функция разница_дней(дата1, дата2) {
    // Разница в днях
    вернуть (дата1 - дата2).days
}

функция разница_секунд(дата1, дата2) {
    // Разница в секундах
    вернуть int((дата1 - дата2).total_seconds())
}

функция разница_часов(дата1, дата2) {
    // Разница в часах
    вернуть int((дата1 - дата2).total_seconds() / 3600)
}

функция разница_минут(дата1, дата2) {
    // Разница в минутах
    вернуть int((дата1 - дата2).total_seconds() / 60)
}

функция сколько_до(дата_будущего) {
    // Сколько осталось до указанной даты от сегодня
    вернуть разница_дней(дата_будущего, сегодня())
}

функция сколько_прошло(дата_прошлого) {
    // Сколько прошло с указанной даты до сегодня
    вернуть разница_дней(сегодня(), дата_прошлого)
}

функция возраст(дата_рождения) {
    // Вычисляет возраст в годах по дате рождения
    пусть сейчас_дата = сегодня()
    пусть возраст_лет = сейчас_дата.year - дата_рождения.year
    
    // Если день рождения ещё не наступил в этом году — минус год
    если (сейчас_дата.month < дата_рождения.month или 
        (сейчас_дата.month == дата_рождения.month и сейчас_дата.day < дата_рождения.day)) {
        возраст_лет = возраст_лет - 1
    }
    
    вернуть возраст_лет
}


// --------------------------------------------
//   СРАВНЕНИЕ
// --------------------------------------------

функция раньше?(дата1, дата2) {
    // Дата1 раньше даты2?
    вернуть дата1 < дата2
}

функция позже?(дата1, дата2) {
    // Дата1 позже даты2?
    вернуть дата1 > дата2
}

функция равна?(дата1, дата2) {
    // Даты равны?
    вернуть дата1 == дата2
}

функция между?(дата, начало, конец) {
    // Дата находится между началом и концом (включительно)?
    вернуть дата >= начало и дата <= конец
}

функция старая?(дата, дней) {
    // Дата старше указанного количества дней?
    вернуть разница_дней(сегодня(), дата) > дней
}

функция будущая?(дата) {
    // Дата в будущем?
    вернуть дата > сегодня()
}

функция прошлая?(дата) {
    // Дата в прошлом?
    вернуть дата < сегодня()
}


// --------------------------------------------
//   ЧАСОВЫЕ ПОЯСА
// --------------------------------------------

функция часовой_пояс(объект, пояс) {
    // Устанавливает часовой пояс.
    // пояс: "UTC", "Europe/Moscow", "America/New_York" и т.д.
    подключить_питон("datetime")
    подключить_питон("pytz")
    попробовать {
        пусть зона = pytz.timezone(пояс)
        вернуть объект.replace(tzinfo=зона)
    } поймать (ошибка) {
        бросить "Не удалось установить часовой пояс: " + ошибка
    }
}

функция в_москву(объект) {
    // Переводит в московское время
    подключить_питон("pytz")
    пусть зона = pytz.timezone("Europe/Moscow")
    вернуть объект.astimezone(зона)
}

функция в_utc(объект) {
    // Переводит в UTC
    подключить_питон("datetime")
    подключить_питон("pytz")
    пусть зона = pytz.UTC
    если (объект.tzinfo == ничего) {
        объект = объект.replace(tzinfo=pytz.UTC)
    }
    вернуть объект.astimezone(зона)
}

функция пояс_сейчас(пояс) {
    // Текущее время в указанном часовом поясе
    подключить_питон("datetime")
    подключить_питон("pytz")
    пусть зона = pytz.timezone(пояс)
    вернуть datetime.datetime.now(зона)
}


// --------------------------------------------
//   КАЛЕНДАРНЫЕ УТИЛИТЫ
// --------------------------------------------

функция високосный?(год) {
    // Високосный ли год
    подключить_питон("calendar")
    вернуть calendar.isleap(год)
}

функция дней_в_месяце(год, месяц) {
    // Количество дней в месяце
    подключить_питон("calendar")
    вернуть calendar.monthrange(год, месяц)[1]
}

функция первый_день_месяца(год, месяц) {
    // Первый день указанного месяца
    вернуть создать(год, месяц, 1)
}

функция последний_день_месяца(год, месяц) {
    // Последний день указанного месяца
    пусть дней = дней_в_месяце(год, месяц)
    вернуть создать(год, месяц, дней)
}

функция начало_дня(дата) {
    // Начало дня (00:00:00)
    вернуть создать_datetime(дата.year, дата.month, дата.day, 0, 0, 0)
}

функция конец_дня(дата) {
    // Конец дня (23:59:59)
    вернуть создать_datetime(дата.year, дата.month, дата.day, 23, 59, 59)
}

функция рабочий_день?(дата) {
    // Является ли день рабочим (не выходной)
    пусть день_недели_число = дата.weekday()
    вернуть день_недели_число < 5
}

функция выходной?(дата) {
    // Выходной ли день
    вернуть рабочий_день?(дата) == ложь
}

функция следующий_рабочий(дата) {
    // Ближайший рабочий день после указанной даты
    пусть результат = добавить_дней(дата, 1)
    пока (выходной?(результат)) {
        результат = добавить_дней(результат, 1)
    }
    вернуть результат
}
